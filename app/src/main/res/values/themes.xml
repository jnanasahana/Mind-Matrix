<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme forced to Light for the Oceanic look -->
    <style name="Theme.GramaYatri" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Ensure backgrounds stay light -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/pure_black</item>

        <!-- Forced Light Mode for high-glare rural conditions -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:textColor">@color/pure_black</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
    </style>
</resources>